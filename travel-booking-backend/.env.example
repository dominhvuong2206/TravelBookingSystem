# Core runtime (required)
# Preferred in production; leave empty locally to use the MYSQL* values below.
HIBERNATE_CONNECTION_URL=
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLDATABASE=travelbookingdb
MYSQLUSER=root
MYSQLPASSWORD=change-me
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRATION_MS=86400000

# Public URLs / CORS
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080/TravelBookingSystem
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Media upload (required when creating services/users with images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment gateways (configure only the gateways you use)
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
